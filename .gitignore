# Never commit keys, tokens, saves, dumps or DB files (CLAUDE.md).
# Runtime data lives in GOS_HOME, outside the repo. WO-0.1 adds the Python, Node and Gradle ignores.
.env
.env.*
*.pem
*.key
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db
*.db-wal
*.db-shm
*.db-journal
*.mca
level.dat
level.dat_old

# Python (uv, pytest, ruff)
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Node (dashboard/)
node_modules/
/dashboard/dist/

# Gradle (mod/). /mod/run/ is the runServer test world: saves never go in git.
# Anchor build dirs: a bare build/ would also hide the source package core/gregtec/build/.
/mod/.gradle/
/mod/build/
/mod/run/
