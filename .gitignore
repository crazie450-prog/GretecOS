# Never commit keys, tokens, saves, dumps or DB files (CLAUDE.md).
# Runtime data lives in GOS_HOME, outside the repo. WO-0.1 adds the Python, Node and Gradle ignores.
.env
.env.*
*.pem
*.key
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db
*.db-wal
*.db-shm
*.db-journal
*.mca
level.dat
level.dat_old

# Python (uv, pytest, ruff)
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Node (dashboard/)
node_modules/
/dashboard/dist/
# Playwright's own output (dashboard e2e): screenshots and traces stay out of git (WO-2.6).
/dashboard/test-results/
/dashboard/playwright-report/

# Gradle (mod/). /mod/run/ is the runServer test world: saves never go in git.
# Anchor build dirs: a bare build/ would also hide the source package core/gregtec/build/.
/mod/.gradle/
/mod/.kotlin/
/mod/build/
/mod/run/

# Jars, dumps and exports never go in git (WO-1.1). The Gradle wrapper jar is the one exception
# (upstream Gradle 9.7.1 wrapper, sha256 checked against services.gradle.org).
# `git add -A` skips an ignored jar silently: a test-fixture jar needs its own `!` line here.
*.jar
!/mod/gradle/wrapper/gradle-wrapper.jar
dumps/
gregteclink/exports/
harness-result.json
