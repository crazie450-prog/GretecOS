{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gregtec-os:contracts:oc-bridge:1",
  "title": "gos-oc-bridge/1",
  "description": "The OpenComputers bridge contract (docs/contracts/oc_bridge.md): the telemetry document the OC agent sends (oc/gos-agent.lua, WO-7.2) and the reply the core returns (WO-7.1). Validate a document against #/$defs/telemetry or #/$defs/reply.",
  "oneOf": [{ "$ref": "#/$defs/telemetry" }, { "$ref": "#/$defs/reply" }],
  "$defs": {
    "address": {
      "description": "An OpenComputers component address (a UUID).",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "registry_name": {
      "description": "An item's registry name (modid:name). Never a numeric id.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.\\-]+:[^\\s]+$"
    },
    "damage": { "description": "Item damage (meta).", "type": "integer", "minimum": 0, "maximum": 32767 },
    "seconds": { "description": "computer.uptime() of the OC computer, in seconds.", "type": "number", "minimum": 0 },
    "eu": { "type": "integer", "minimum": 0 },
    "decimal": { "description": "A non-negative integer as decimal digits, exact beyond 64 bits.", "type": "string", "pattern": "^[0-9]+$", "maxLength": 80 },
    "xyz": { "type": "array", "items": { "type": "integer" }, "minItems": 3, "maxItems": 3 },
    "meta_name": { "description": "GT's meta tile entity name (getName()), e.g. multimachine.blastfurnace.", "type": "string", "maxLength": 128 },
    "sensor": {
      "description": "getSensorInformation() lines exactly as the driver returned them (2.9: 'key\\\\arg\\\\arg' or server-side localised text, with section-sign codes). Parsed by the core, never by the agent.",
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 200 }
    },
    "command_id": { "description": "The core's action id (action.id).", "type": "integer", "minimum": 1 },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "kind", "agent", "boot", "seq", "uptime", "transport", "cycle_s", "sample_s", "computer", "components", "power", "machines", "crafts", "results", "errors"],
      "properties": {
        "v": { "const": 1 },
        "kind": { "const": "telemetry" },
        "agent": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "boot": { "description": "Random per agent start; seq starts again at 1 with a new boot.", "type": "string", "pattern": "^[0-9a-f]{8}$" },
        "seq": { "type": "integer", "minimum": 1 },
        "uptime": { "$ref": "#/$defs/seconds" },
        "transport": { "enum": ["http", "mailbox"] },
        "cycle_s": { "type": "number", "minimum": 5, "maximum": 10 },
        "sample_s": { "type": "number", "minimum": 0 },
        "computer": { "$ref": "#/$defs/computer" },
        "tick_ms": { "description": "The server's mean tick time from a tps_card, when one is in.", "type": "number", "minimum": 0 },
        "components": {
          "description": "How many components of each type the computer sees.",
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9_]+$" },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "power": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/power" } },
        "machines": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/machine" } },
        "ae2": { "$ref": "#/$defs/ae2" },
        "crafts": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/craft" } },
        "results": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/result" } },
        "errors": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/error" } },
        "display": { "$ref": "#/$defs/shows" },
        "crops": { "$ref": "#/$defs/crops" }
      }
    },
    "shows": {
      "description": "What the agent draws (WO-7.4, D277): the display rev it shows (0: none yet), the highest chat notice id it has said this boot (0: none), its status board's text area, and whether it draws the OCGlasses HUD and says chat notices.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rev", "said", "hud", "chat"],
      "properties": {
        "rev": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "said": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "board": {
          "type": "object",
          "additionalProperties": false,
          "required": ["w", "h"],
          "properties": {
            "w": { "type": "integer", "minimum": 10, "maximum": 160 },
            "h": { "type": "integer", "minimum": 4, "maximum": 50 }
          }
        },
        "hud": { "type": "boolean" },
        "chat": { "type": "boolean" }
      }
    },
    "display": {
      "description": "The in-game displays' content (WO-7.4, D277): sent when its rev differs from the one the agent shows, or a chat notice is waiting. Printable ASCII only, cut to fit OC's smallest screen.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rev"],
      "properties": {
        "rev": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "lines": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/board_line" } },
        "hud": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/hud_line" } },
        "chat": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/notice" } }
      }
    },
    "board_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "c"],
      "properties": {
        "t": { "type": "string", "maxLength": 48, "pattern": "^[ -~]*$" },
        "c": { "enum": ["ok", "warn", "bad", "info", "dim"] }
      }
    },
    "hud_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "c"],
      "properties": {
        "t": { "type": "string", "maxLength": 40, "pattern": "^[ -~]*$" },
        "c": { "enum": ["ok", "warn", "bad", "info", "dim"] }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "t"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "t": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[ -~]+$" }
      }
    },
    "computer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "arch", "mem_free", "mem_total", "energy", "energy_max"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "arch": { "type": "string", "maxLength": 32 },
        "mem_free": { "type": "integer", "minimum": 0 },
        "mem_total": { "type": "integer", "minimum": 0 },
        "energy": { "type": "number", "minimum": 0 },
        "energy_max": { "type": "number", "minimum": 0 }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addr", "type", "kind"],
      "properties": {
        "addr": { "$ref": "#/$defs/address" },
        "type": { "enum": ["gt_machine", "gt_batterybuffer", "lsc"] },
        "kind": { "enum": ["battery_buffer", "storage"] },
        "name": { "$ref": "#/$defs/meta_name" },
        "xyz": { "$ref": "#/$defs/xyz" },
        "eu": { "$ref": "#/$defs/eu" },
        "eu_max": { "$ref": "#/$defs/eu" },
        "eu_str": { "$ref": "#/$defs/decimal" },
        "eu_max_str": { "$ref": "#/$defs/decimal" },
        "eu_in": { "type": "integer" },
        "eu_out": { "type": "integer" },
        "sensor": { "$ref": "#/$defs/sensor" },
        "sensor_at": { "$ref": "#/$defs/seconds" }
      },
      "dependentRequired": { "sensor": ["sensor_at"] },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "battery_buffer" } } },
          "then": { "not": { "anyOf": [{ "required": ["eu_str"] }, { "required": ["eu_max_str"] }] } }
        },
        {
          "if": { "properties": { "kind": { "const": "storage" } } },
          "then": { "not": { "anyOf": [{ "required": ["eu"] }, { "required": ["eu_max"] }] } }
        }
      ]
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addr", "type"],
      "properties": {
        "addr": { "$ref": "#/$defs/address" },
        "type": { "const": "gt_machine" },
        "name": { "$ref": "#/$defs/meta_name" },
        "xyz": { "$ref": "#/$defs/xyz" },
        "active": { "type": "boolean" },
        "allowed": { "type": "boolean" },
        "work": { "type": "boolean" },
        "progress": { "type": "integer" },
        "progress_max": { "type": "integer" },
        "eu": { "$ref": "#/$defs/eu" },
        "eu_max": { "$ref": "#/$defs/eu" },
        "sensor": { "$ref": "#/$defs/sensor" },
        "sensor_at": { "$ref": "#/$defs/seconds" }
      },
      "dependentRequired": { "sensor": ["sensor_at"] }
    },
    "ae2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addr", "type", "cpus"],
      "properties": {
        "addr": { "$ref": "#/$defs/address" },
        "type": { "enum": ["me_controller", "me_interface"] },
        "cpus": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/cpu" } },
        "items": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/item" } },
        "items_at": { "$ref": "#/$defs/seconds" }
      },
      "dependentRequired": { "items": ["items_at"] }
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "storage", "coprocessors", "busy"],
      "properties": {
        "name": { "type": "string", "maxLength": 64 },
        "storage": { "type": "integer", "minimum": 0 },
        "coprocessors": { "type": "integer", "minimum": 0 },
        "busy": { "type": "boolean" }
      }
    },
    "item": {
      "description": "One watchlist entry: the stack of that registry name and damage with no NBT, from one exact AE2 lookup (getItemInNetwork); size 0 when none is stored.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "damage", "size", "craftable"],
      "properties": {
        "name": { "$ref": "#/$defs/registry_name" },
        "damage": { "$ref": "#/$defs/damage" },
        "size": { "type": "integer", "minimum": 0 },
        "craftable": { "type": "boolean" }
      }
    },
    "craft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "damage", "amount", "state", "at"],
      "properties": {
        "id": { "$ref": "#/$defs/command_id" },
        "name": { "$ref": "#/$defs/registry_name" },
        "damage": { "$ref": "#/$defs/damage" },
        "amount": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["computing", "crafting", "done", "canceled", "failed"] },
        "err": { "type": "string", "maxLength": 200 },
        "at": { "$ref": "#/$defs/seconds" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "ok", "state", "at"],
      "properties": {
        "id": { "$ref": "#/$defs/command_id" },
        "kind": { "type": "string", "maxLength": 32 },
        "ok": { "type": "boolean" },
        "state": { "enum": ["done", "submitted", "failed", "refused"] },
        "err": { "type": "string", "maxLength": 200 },
        "at": { "$ref": "#/$defs/seconds" }
      },
      "if": { "properties": { "ok": { "const": true } } },
      "then": { "properties": { "state": { "enum": ["done", "submitted"] } }, "not": { "required": ["err"] } },
      "else": { "properties": { "state": { "enum": ["failed", "refused"] } }, "required": ["err"] }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "where", "msg", "count"],
      "properties": {
        "at": { "$ref": "#/$defs/seconds" },
        "where": { "enum": ["discover", "power", "machines", "sensor", "ae2", "tps", "command", "transport", "state", "cycle"] },
        "msg": { "type": "string", "maxLength": 200 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "ok", "cmds"],
      "properties": {
        "v": { "const": 1 },
        "ok": { "type": "boolean" },
        "cmds": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/command" } },
        "err": { "type": ["string", "null"], "maxLength": 200 },
        "ack": { "type": "integer", "minimum": 1 },
        "boot": { "description": "The agent's boot that ack counts in; it always comes with ack (D216).", "type": "string", "pattern": "^[0-9a-f]{8}$" },
        "poll_s": { "type": "integer", "minimum": 1, "maximum": 10 },
        "display": { "$ref": "#/$defs/display" }
      },
      "dependentRequired": { "ack": ["boot"] },
      "if": { "properties": { "ok": { "const": false } } },
      "then": {
        "required": ["err"],
        "properties": {
          "cmds": { "maxItems": 0 },
          "err": { "enum": ["unauthorized", "bad_payload", "unsupported_version", "internal"] }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "args", "confirmed_via"],
      "properties": {
        "id": { "$ref": "#/$defs/command_id" },
        "kind": { "enum": ["craft", "machine_pause", "machine_resume", "say", "crop_start", "crop_stop"] },
        "args": { "type": "object" },
        "confirmed_via": { "enum": ["voice", "dashboard", "phone", "discord"] }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "craft" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/craft_args" } } } },
        {
          "if": { "properties": { "kind": { "enum": ["machine_pause", "machine_resume"] } } },
          "then": { "properties": { "args": { "$ref": "#/$defs/machine_args" } } }
        },
        { "if": { "properties": { "kind": { "const": "say" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/say_args" } } } },
        {
          "if": { "properties": { "kind": { "const": "crop_start" } } },
          "then": { "properties": { "args": { "$ref": "#/$defs/crop_start_args" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "crop_stop" } } },
          "then": { "properties": { "args": { "$ref": "#/$defs/crop_stop_args" } } }
        }
      ]
    },
    "craft_args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "damage", "amount"],
      "properties": {
        "name": { "$ref": "#/$defs/registry_name" },
        "damage": { "$ref": "#/$defs/damage" },
        "amount": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "cpu": { "type": "string", "maxLength": 64 }
      }
    },
    "machine_args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addr"],
      "properties": { "addr": { "$ref": "#/$defs/address" } }
    },
    "say_args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 256 } }
    },
    "seed_label": {
      "description": "An analysed CropsNH seed's label, '<crop name> Seeds' (cropsnh:genericSeed's display name, which names the species; WO-7.6). Never 'Unknown Seeds' (not analysed) or a numeric id.",
      "type": "string",
      "minLength": 7,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f]+ Seeds$",
      "not": { "enum": ["Unknown Seeds", "Invalid Seeds"] }
    },
    "crop_item": {
      "description": "A catalyst by registry name and damage, and how many one run or one copy uses.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "damage", "n"],
      "properties": {
        "name": { "$ref": "#/$defs/registry_name" },
        "damage": { "$ref": "#/$defs/damage" },
        "n": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "crop_step": {
      "description": "One Crop Breeder recipe of a breeding plan.",
      "type": "object",
      "additionalProperties": false,
      "required": ["child", "parents", "cat", "copies", "fert"],
      "properties": {
        "child": { "$ref": "#/$defs/seed_label" },
        "parents": { "type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/seed_label" } },
        "cat": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/crop_item" } },
        "copies": { "description": "Seeds of each parent before the step's first run, when a copier makes them.", "type": "integer", "minimum": 2, "maximum": 64 },
        "fert": { "description": "mB of enriched fertilizer one run takes (GOS computes it).", "type": "integer", "minimum": 1, "maximum": 256000 },
        "ref": { "description": "The recipe's r: id, for the log.", "type": "string", "maxLength": 80 }
      }
    },
    "crop_start_args": {
      "description": "A breeding plan GOS built (gregtec.crops.station), run by oc/crop/station.lua.",
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "target", "count", "steps"],
      "properties": {
        "plan": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
        "target": { "$ref": "#/$defs/seed_label" },
        "count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "steps": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/crop_step" } },
        "copy": {
          "description": "The crops worth a Seed Generator (a copier), best first.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/seed_label" }
        },
        "copy_cat": {
          "description": "A crop's duplication catalyst for the Seed Generator, by its label.",
          "type": "object",
          "maxProperties": 8,
          "propertyNames": { "$ref": "#/$defs/seed_label" },
          "additionalProperties": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/crop_item" } }
        },
        "copy_fert": {
          "description": "mB of fertilizer one Seed Generator copy of a crop takes (GOS computes it), by its label; checked before a seed is parked.",
          "type": "object",
          "maxProperties": 8,
          "propertyNames": { "$ref": "#/$defs/seed_label" },
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 256000 }
        }
      }
    },
    "crop_stop_args": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "crops": {
      "description": "The breeding station's status (WO-7.6), in every message of an agent with a crops table.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "runs", "ok", "fail", "stock"],
      "properties": {
        "state": { "enum": ["idle", "running", "stopping", "stopped", "done", "failed", "interrupted"] },
        "plan": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
        "action": { "$ref": "#/$defs/command_id" },
        "target": { "$ref": "#/$defs/seed_label" },
        "count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "steps": { "type": "integer", "minimum": 1, "maximum": 8 },
        "step": { "description": "The step of the run under way.", "type": "integer", "minimum": 1, "maximum": 8 },
        "runs": { "type": "integer", "minimum": 0 },
        "ok": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "doing": { "type": "string", "maxLength": 200 },
        "note": { "type": "string", "maxLength": 200 },
        "stock": {
          "description": "The plan's seeds in the chest, by label.",
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "$ref": "#/$defs/seed_label" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "copiers": {
          "description": "Each Seed Generator's parked crop (its label), or false when it holds none.",
          "type": "array",
          "maxItems": 3,
          "items": { "oneOf": [{ "$ref": "#/$defs/seed_label" }, { "const": false }] }
        },
        "cat_left": {
          "description": "Items other than seeds (duplication catalysts) in each Seed Generator's inputs, which GT never gives back.",
          "type": "array",
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
